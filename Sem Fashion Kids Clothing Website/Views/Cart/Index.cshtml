@model IEnumerable<Sem_Fashion_Kids_Clothing_Website.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal grandTotal = 0;
}

<div class="container py-5">

    <!-- PAGE TITLE -->
    <div class="text-center mb-4">
        <h2 class="fw-bold">
            🛒 Shopping Cart
        </h2>
        <p class="text-muted">
            Review your selected products before checkout
        </p>
    </div>

    @if (!Model.Any())
    {
        <!-- EMPTY CART -->
        <div class="card shadow-sm border-0 rounded-4 p-5 text-center">

            <div class="mb-3" style="font-size:70px;">
                🛒
            </div>

            <h3 class="fw-bold mb-3">
                Your cart is empty
            </h3>

            <p class="text-muted mb-4">
                Looks like you haven't added any products yet.
            </p>

            <div>
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-primary px-4 py-2 rounded-pill">
                    🛍 Continue Shopping
                </a>
            </div>

        </div>
    }
    else
    {
        <!-- CART CARD -->
        <div class="card border-0 shadow-lg rounded-4">

            <div class="card-body p-4">

                <div class="table-responsive">

                    <table class="table align-middle text-center">

                        <thead class="border-bottom">
                            <tr class="text-secondary">

                                <th class="fw-semibold">Product</th>
                                <th class="fw-semibold">Unit Price</th>
                                <th class="fw-semibold">Quantity</th>
                                <th class="fw-semibold">Total</th>
                                <th class="fw-semibold">Action</th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                var price = item.Product?.Price ?? 0;
                                var total = price * item.Quantity;

                                grandTotal += total;

                                <tr>

                                    <!-- PRODUCT -->
                                    <td>
                                        <div class="d-flex align-items-center">

                                            <img src="@(item.Product?.ImageUrl ?? "/images/default.png")"
                                                 class="rounded-3 shadow-sm me-3"
                                                 style="width:80px;
                                                        height:80px;
                                                        object-fit:cover;" />

                                            <div class="text-start">

                                                <h6 class="fw-bold mb-1">
                                                    @item.Product?.Name
                                                </h6>

                                            @*     <small class="text-muted">
                                                    Kids Fashion Product
                                                </small> *@

                                            </div>

                                        </div>
                                    </td>

                                    <!-- PRICE -->
                                    <td class="fw-semibold text-success">
                                        @price.ToString("N2") ETB
                                    </td>

                                    <!-- QUANTITY -->
                                    <td>
                                        <span class="badge bg-dark px-3 py-2 rounded-pill">
                                            @item.Quantity
                                        </span>
                                    </td>

                                    <!-- TOTAL -->
                                    <td class="fw-bold">
                                        @total.ToString("N2") ETB
                                    </td>

                                    <!-- ACTION -->
                                    <td>

                                        <a asp-action="Remove"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                            🗑 Remove
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- TOTAL SECTION -->
        <div class="card border-0 shadow-sm rounded-4 mt-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center flex-wrap">

                    <!-- CONTINUE SHOPPING -->
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-primary rounded-pill px-4">
                        ← Continue Shopping
                    </a>

                    <!-- TOTAL -->
                    <div class="text-center">

                        <h5 class="mb-1 text-muted">
                            Grand Total
                        </h5>

                        <h2 class="fw-bold text-success">
                            @grandTotal.ToString("N2") ETB
                        </h2>

                    </div>

                    <!-- CHECKOUT -->
                    <div>

                        <a asp-action="Clear"
                           class="btn btn-outline-danger rounded-pill px-4 me-2">
                            🧹 Clear Cart
                        </a>

                        <a asp-controller="Order"
                           asp-action="Checkout"
                           class="btn btn-success rounded-pill px-4">
                            💳 Checkout
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

<style>

    body {
        background-color: #f8f9fa;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.2s ease;
    }

    .card {
        overflow: hidden;
    }

    .btn {
        font-weight: 500;
    }

</style>