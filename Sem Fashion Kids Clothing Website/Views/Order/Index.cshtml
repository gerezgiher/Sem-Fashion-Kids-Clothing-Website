@model IEnumerable<Sem_Fashion_Kids_Clothing_Website.Models.Order>

@{
    ViewData["Title"] = "Orders Management";
}

<h3 class="text-center mb-4 fw-bold">📦 Orders Management</h3>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <h4 class="text-muted">No orders yet 😢</h4>
    </div>
}
else
{
    <style>
        #ordersTable tbody tr {
            cursor: pointer;
        }

            #ordersTable tbody tr:hover {
                background-color: #f4f6f9 !important;
            }

        .receipt-img {
            border-radius: 6px;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

            .receipt-img:hover {
                transform: scale(1.1);
            }
    </style>

    <div class="table-responsive">

        <!-- ✅ IMPORTANT: add custom-datatable -->
        <table id="ordersTable"
               class="table table-striped table-bordered custom-datatable">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer Name</th>
                    <th>Phone</th>
                    <th>Total</th>
                    <th>Payment Method</th>
                    <th>Payment Status</th>
                    <th>Proof</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Model)
                {
                    <tr data-href="@Url.Action("Details", "Order", new { id = order.Id })">

                        <td>@order.Id</td>

                        <td class="fw-semibold">@order.CustomerName</td>

                        <td>@order.Phone</td>

                        <td class="text-success fw-bold">
                            @order.TotalAmount ETB
                        </td>

                        <td>
                            @if (order.PaymentMethod == "Telebirr")
                            {
                                <span class="badge bg-primary">📱 Telebirr</span>
                            }
                            else if (order.PaymentMethod == "Bank")
                            {
                                <span class="badge bg-dark">🏦 Bank</span>
                            }
                        </td>

                        <td>
                            @if (order.IsPaid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Unpaid</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(order.PaymentProofImage))
                            {
                                <img src="~/uploads/@order.PaymentProofImage"
                                     width="60"
                                     class="receipt-img"
                                     onclick="showImage(this.src)" />
                            }
                            else if (order.PaymentMethod == "Telebirr" && order.IsPaid)
                            {
                                <span class="text-success">✔ Verified</span>
                            }
                            else
                            {
                                <span class="text-muted">No proof</span>
                            }
                        </td>

                        <td>
                            @order.OrderDate.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @if (string.IsNullOrEmpty(order.Status) ||
                           order.Status == "Pending" ||
                           order.Status == "Pending Approval")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (order.Status == "Approved" && order.IsPaid)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (order.Status == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-1 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Details
                                </a>

                                @if (!order.IsPaid)
                                {
                                    <a asp-action="Approve"
                                       asp-route-id="@order.Id"
                                       class="btn btn-outline-success btn-sm">
                                        Approve
                                    </a>
                                }

                                <a asp-action="Reject"
                                   asp-route-id="@order.Id"
                                   class="btn btn-outline-warning btn-sm">
                                    Reject
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@order.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Delete this order?')">
                                    Delete
                                </a>

                            </div>
                        </td>

                    </tr>
                }
            </tbody>

        </table>
    </div>

    <!-- ✅ IMAGE MODAL -->
    <div class="modal fade" id="imageModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body text-center">
                    <img id="modalImage" class="img-fluid rounded shadow" />
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ ONLY SCRIPT YOU NEED (NO DATATABLE INIT HERE) -->
    @section Scripts {
    <script>
        function showImage(src) {
            document.getElementById("modalImage").src = src;
            var modal = new bootstrap.Modal(document.getElementById('imageModal'));
            modal.show();
        }
    </script>
    }
}