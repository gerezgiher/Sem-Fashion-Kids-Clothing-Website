<section class="promo-banner text-center text-white">
    <div class="container">
        <h2>🎉 New Collection Available</h2>
        <p>Quality Kids Fashion at Great Prices</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-warning">Shop Today</a>
    </div>
</section>

<!-- ================= PRODUCTS ================= -->
<div class="container my-5" id="products">

    <div class="text-center mb-5">
        <h2 class="fw-bold">🔥 Latest Collection</h2>
        <p class="text-muted">Handpicked fashion for your kids</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h4 class="text-muted">No products available 😢</h4>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                    <div class="card product-card border-0 shadow-sm h-100">

                        <div class="product-image-wrapper position-relative">

                            <img src="@item.ImageUrl"
                                 class="card-img-top product-img" />

                            <!-- OPTIONAL: dynamic badge -->
                            @if (item.IsFeatured)
                            {
                                <span class="badge bg-success product-badge">
                                    New
                                </span>
                            }

                        </div>

                        <div class="card-body d-flex flex-column text-center">

                            <h6 class="fw-bold text-truncate">@item.Name</h6>

                            <small class="text-muted">
                                @item.Category?.Name
                            </small>

                            <h5 class="text-success fw-bold mt-2">
                                @item.Price ETB
                            </h5>

                            <div class="d-grid gap-2 mt-auto">

                                <a asp-controller="Cart"
                                   asp-action="AddToCart"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary">
                                    Add to Cart 🛒
                                </a>

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    View Details
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
<section class="bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">Customer Reviews</h2>

        <div class="row g-4">

            @if (ViewBag.Reviews != null)
            {
                @foreach (var review in (List<Sem_Fashion_Kids_Clothing_Website.Models.Review>)ViewBag.Reviews)
                {
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100 p-3">

                            <div class="text-warning fs-5">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <span>⭐</span>
                                }
                            </div>

                            <p class="mt-3">@review.Comment</p>

                            <strong>
                                - @review.User?.FullName 
                            </strong>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">No customer reviews yet.</p>
                </div>
            }

        </div>
    </div>
</section>

<section class="container py-5 text-center">
    <h2>Contact Us</h2>
    <p>📞 +251 936882896 | ✉️ Gerezgiher96@gmail.com | 📍 Addis Ababa</p>
    <a href="https://wa.me/251936882896" target="_blank" class="btn btn-success btn-lg">WhatsApp Us</a>
</section>

<style>
    .hero-section {
        min-height: 80vh;
        background: linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),url('/images/hero-kids-fashion.jpg') center/cover;
        display: flex;
        align-items: center
    }

    .hero-content {
        padding: 80px 0
    }

    .stat-card, .product-card, .category-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
        transition: .3s
    }

        .stat-card:hover, .product-card:hover, .category-card:hover {
            transform: translateY(-8px)
        }

    .category-card {
        padding: 35px;
        background: #fff
    }

    .promo-banner {
        background: linear-gradient(90deg,#0d6efd,#6610f2);
        padding: 70px 0
    }

    .product-img {
        height: 260px;
        object-fit: cover;
        transition: .4s
    }

    .product-card:hover .product-img {
        transform: scale(1.08)
    }

    .btn {
        border-radius: 30px
    }
</style>
