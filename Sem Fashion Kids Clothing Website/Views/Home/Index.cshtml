<!-- HERO -->
<section class="hero-section text-white">
    <div class="container hero-content text-center">
        <span class="badge bg-warning text-dark px-3 py-2 mb-3">Welcome to Sem Kids Fashion</span>
        <h1 class="display-3 fw-bold">Sem (ሴም) Kids Fashion & Toys</h1>
        <p class="lead">Premium Kids Clothing, Toys & Accessories in Ethiopia</p>

        <div class="hero-contact my-4">
            <span class="me-4">📞 +251 936882896</span>
            <span class="me-4">✉️ Gerezgiher96@gmail.com</span>
            <span>📍 Addis Ababa</span>
        </div>

        <a asp-controller="Products" asp-action="Index" class="btn btn-warning btn-lg px-5 me-2">Shop Now</a>
        <a href="#products" class="btn btn-outline-light btn-lg">Explore Collection</a>
    </div>
</section>

<!-- STATS -->
<section class="container py-5">
    <div class="row g-4 text-center">
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="display-5">📦</div><h3>@ViewBag.ProductCount</h3><p>Products</p></div></div></div>
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="display-5">😊</div><h3>@ViewBag.CustomerCount</h3><p>Happy Customers</p></div></div></div>
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="display-5">🚚</div><h3>Fast</h3><p>Delivery</p></div></div></div>
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="display-5">🎧</div><h3>24/7</h3><p>Support</p></div></div></div>
    </div>
</section> 

