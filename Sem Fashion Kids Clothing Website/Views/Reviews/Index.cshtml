@model IEnumerable<Sem_Fashion_Kids_Clothing_Website.Models.Review>

@{
    ViewData["Title"] = "Manage Customer Reviews";
}


<div class="container py-5">


    <h3 class="text-center mb-4 fw-bold">
        ⭐ Manage Customer Reviews
    </h3>



    @if (!Model.Any())
    {
        <div class="text-center mt-4">
            <h5 class="text-muted">
                No customer reviews found 😢
            </h5>
        </div>
    }
    else
    {

        <div class="table-responsive">


            <table id="reviewTable"
                   class="table table-striped table-bordered custom-datatable">


                <thead>

                    <tr>

                        <th>Customer Name</th>

                        <th>
                            Rating
                        </th>

                        <th>
                            Comment
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>



                <tbody>


                    @foreach (var review in Model)
                    {

                        <tr>


                            <td class="fw-semibold">

                                <i class="fas fa-user me-1"></i>

                                @review.User?.FullName

                            </td>

                            <td>
                                @review.Rating ⭐
                            </td>


                            <td>
                                @review.Comment
                            </td>


                            <td>

                                @if (review.IsApproved)
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">
                                        Pending
                                    </span>
                                }

                            </td>


                            <td>

                                @if (!review.IsApproved)
                                {
                                    <a asp-action="Approve"
                                       asp-route-id="@review.Id"
                                       class="btn btn-success btn-sm">

                                        <i class="fas fa-check"></i> Approve

                                    </a>
                                }


                                <a asp-action="Reject"
                                   asp-route-id="@review.Id"
                                   class="btn btn-danger btn-sm">

                                    <i class="fas fa-times"></i> Reject

                                </a>


                                <!-- DELETE BUTTON -->
                                <a asp-action="DeleteAdmin"
                                   asp-route-id="@review.Id"
                                   class="btn btn-dark btn-sm">
                                    <i class="fas fa-trash"></i> Delete
                                </a>


                            </td>


                       


                        </tr>

                    }


                </tbody>


            </table>


        </div>

    }


</div>