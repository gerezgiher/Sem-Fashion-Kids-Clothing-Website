@model IEnumerable<Sem_Fashion_Kids_Clothing_Website.Models.Review>

@{
    ViewData["Title"] = "My Reviews";
}


<div class="container py-4">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold">
            ⭐ My Reviews
        </h3>


        <a asp-controller="Reviews"
           asp-action="Create"
           class="btn btn-success">

            <i class="fas fa-pen me-1"></i>
            Write Review

        </a>

    </div>



    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">

            <i class="fas fa-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }



    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">

            <i class="fas fa-exclamation-triangle me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }



    @if (!Model.Any())
    {

        <div class="alert alert-info text-center shadow-sm">

            <h5>
                You have not submitted any reviews yet.
            </h5>


            <p>
                Share your shopping experience with other customers.
            </p>


            <a asp-action="Create"
               class="btn btn-primary">

                <i class="fas fa-star"></i>
                Write Your First Review

            </a>

        </div>

    }
    else
    {
        <div class="table-responsive">


            <table class="table table-striped table-bordered custom-datatable">


                <thead>

                    <tr>

                        <th>Date</th>

                        <th>Rating</th>

                        <th>Comment</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>



                <tbody>


                    @foreach (var review in Model)
                    {

                        <tr>


                            <td>
                                @review.ReviewDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @review.Rating ⭐
                            </td>

                            <td style="max-width:350px">

                                @review.Comment

                            </td>

                            <td>


                                @if (review.IsApproved)
                                {

                                    <span class="badge bg-success">

                                        <i class="fas fa-check"></i>
                                        Approved

                                    </span>

                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">

                                        <i class="fas fa-clock"></i>
                                        Pending Approval

                                    </span>

                                }


                            </td>



                            <td>


                                <div class="d-flex gap-2">


                                    <a asp-action="Edit"
                                       asp-route-id="@review.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="fas fa-edit"></i>
                                        Edit

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@review.Id"
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>

                                </div>


                            </td>


                        </tr>

                    }


                </tbody>


            </table>


        </div>


    }


</div>